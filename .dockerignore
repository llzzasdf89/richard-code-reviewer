# 依赖（容器内会重新安装）
node_modules

# Next.js 构建产物（容器内会重新构建）
.next

# Git 相关（镜像里不需要）
.git
.gitignore

# 环境变量（通过 env_file 或环境变量注入，不能打进镜像）
.env
.env.local
.env.production

# 文档
README.md
*.md

# Docker 自身文件（不需要复制进去）
Dockerfile
docker-compose.yml
.dockerignore

# 编辑器配置
.vscode
.idea
*.swp

# macOS
.DS_Store

# 日志
*.log
npm-debug.log*